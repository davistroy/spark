# spark-ops.env.example — local alert config for the Spark ops routines.
#
# Copy this to ONE of these locations (both are gitignored / outside the public repo):
#   ~/.spark-ops.env            (preferred — lives outside the repo)
#   ops/spark-ops.env           (repo-local; gitignored)
# ops/_common.sh sources it automatically at runtime. Do NOT commit the real file:
# this repo is public and alert payloads reveal internal ops state (hostnames,
# container/GPU status, listening ports).
#
# Use `:=` assignment so a value already exported in the cron/shell environment wins.

# ntfy.sh (zero-setup): pick an UNGUESSABLE topic, then subscribe to it in the ntfy
# app or at https://ntfy.sh/<your-topic>. Anyone who knows a public topic can read it,
# so keep the name secret.
: "${SPARK_ALERT_WEBHOOK:=https://ntfy.sh/CHANGE-ME-to-an-unguessable-topic}"

# Slack / Discord alternative — any URL that accepts a POST body works:
# : "${SPARK_ALERT_WEBHOOK:=https://hooks.slack.com/services/XXX/YYY/ZZZ}"

export SPARK_ALERT_WEBHOOK

# Optional: email delivery instead of / in addition to the webhook. Requires a working
# mailer (msmtp/sendmail) on this host. Leave unset if you only use the webhook.
# MAILTO="you@example.com"
