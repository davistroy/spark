{
  "uid": "spark-reliability",
  "title": "DGX Spark — Reliability & Faults",
  "tags": ["spark", "reliability", "gpu", "roadmap-phase3"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "annotations": {"list": []},
  "templating": {"list": []},
  "panels": [
    {
      "type": "stat",
      "title": "qwen35 Running",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "spark_qwen35_running", "instant": true}],
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "qwen35 Restart Count",
      "description": "Docker RestartCount. Any increase = a container crash/restart (watch for vllm#37754 MTP/FlashInfer Xid class).",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "spark_qwen35_restart_count", "instant": true}],
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "GPU Xid Events (current logs)",
      "description": "Count of GPU Xid fault lines in kern.log+.1. Non-zero = GPU fault occurred (illegal address / MTP+FlashInfer crash class). Resets on log rotation/reboot.",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "gpu_xid_events_total", "instant": true}],
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}},
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "NVRM Alloc Failures (current logs)",
      "description": "NV_ERR_NO_MEMORY lines in kern.log+.1. Historical eval-window count ages out on rotation; a rising live value indicates UMA memory pressure.",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "nvrm_alloc_failures_total", "instant": true}],
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {
        "defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}]}},
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "GPU Faults Over Time (Xid + NVRM)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [
        {"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "gpu_xid_events_total", "legendFormat": "Xid events"},
        {"refId": "B", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "nvrm_alloc_failures_total", "legendFormat": "NVRM alloc failures"}
      ],
      "fieldConfig": {"defaults": {"custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "type": "timeseries",
      "title": "GPU Power Draw (W) — 14W floor = post-crash throttle bug",
      "description": "If power draw collapses to ~14W with SM clock ~513 MHz, the GPU hit the known post-crash/sleep throttle. Fix = wall power-cycle, not reboot.",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "gpu_power_draw_watts", "legendFormat": "power draw W"}],
      "fieldConfig": {"defaults": {"unit": "watt", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "GPU SM Clock (MHz)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "gpu_clock_graphics_mhz", "legendFormat": "SM clock MHz"}],
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "type": "timeseries",
      "title": "GPU Temperature (°C)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "datasource": {"uid": "PBFA97CFB590B2093"},
      "targets": [{"refId": "A", "datasource": {"uid": "PBFA97CFB590B2093"}, "expr": "gpu_temperature_celsius", "legendFormat": "temp °C"}],
      "fieldConfig": {"defaults": {"unit": "celsius", "custom": {"drawStyle": "line", "fillOpacity": 10, "lineWidth": 2}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    }
  ]
}
